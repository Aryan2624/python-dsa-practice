def binary_search(numbers, target):
    left = 0
    right = len(numbers) - 1

    while left <= right:
        middle = (left + right) // 2

        if numbers[middle] == target:
            return middle
        elif numbers[middle] < target:
            left = middle + 1
        else:
            right = middle - 1

    return -1


if __name__ == "__main__":
    assert binary_search([2, 4, 7, 9, 12], 7) == 2
    assert binary_search([2, 4, 7, 9, 12], 5) == -1
    assert binary_search([], 7) == -1
    assert binary_search([3], 3) == 0

    print("All 4 tests passed!")
